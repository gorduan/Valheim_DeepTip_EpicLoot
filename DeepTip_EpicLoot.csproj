<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DeepTip EpicLoot (BepInEx plugin): explains every EpicLoot property in DeepTip windows.
    Needs DeepTip (Gorduan-DeepTip) and EpicLoot (RandyKnapp-EpicLoot). Paths come from GamePaths.user.props
    (not in git, see GamePaths.user.props.example): GamePath (Valheim with BepInEx\core), DeepTipDll, EpicLootDll.
  -->
  <Import Project="$(MSBuildThisFileDirectory)GamePaths.user.props" Condition="Exists('$(MSBuildThisFileDirectory)GamePaths.user.props')" />
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>DeepTip_EpicLoot</AssemblyName>
    <RootNamespace>DeepTipEpicLoot</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Gorduan</Authors>
    <Company>Gorduan</Company>
    <Product>DeepTip EpicLoot</Product>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</GamePath>
    <Managed>$(GamePath)\valheim_Data\Managed</Managed>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS1591;CS0436</NoWarn>
    <ImplicitlyExpandNETStandardFacades>false</ImplicitlyExpandNETStandardFacades>
    <ImplicitlyExpandDesignTimeFacades>false</ImplicitlyExpandDesignTimeFacades>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoStandardLibraries>true</NoStandardLibraries>
    <AutoUnifyAssemblyReferences>true</AutoUnifyAssemblyReferences>
    <AssemblySearchPaths>{HintPathFromItem};{RawFileName}</AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="mscorlib" HintPath="$(Managed)\mscorlib.dll" Private="false" />
    <Reference Include="System" HintPath="$(Managed)\System.dll" Private="false" />
    <Reference Include="System.Core" HintPath="$(Managed)\System.Core.dll" Private="false" />
    <Reference Include="netstandard" HintPath="$(Managed)\netstandard.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GamePath)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(GamePath)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(Managed)\assembly_valheim.dll" Publicize="true" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(Managed)\assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(Managed)\assembly_guiutils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="GC_Valheim_DeepTip" HintPath="$(DeepTipDll)" Private="false" />
    <Reference Include="EpicLoot" HintPath="$(EpicLootDll)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- concept glossary (DeepTip format) and the code-checked effect explanations, one file per locale -->
    <EmbeddedResource Include="glossary\*.json" LogicalName="DeepTipEpicLoot.%(Filename).json" />
    <EmbeddedResource Include="data\*.json" LogicalName="DeepTipEpicLoot.%(Filename).json" />
  </ItemGroup>
</Project>
